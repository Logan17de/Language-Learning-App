{
  "name": "aiko-japanese",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:seed": "supabase db reset --local",
    "db:types": "supabase gen types --lang typescript --local > types/database.ts",
    "db:validate": "node scripts/validate-supabase.mjs",
    "seed:validate": "node scripts/validate-seed.mjs",
    "jmdict:prepare": "node scripts/prepare-jmdict-bulk.mjs",
    "jmdict:import": "node scripts/run-jmdict-import.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.4.49",
    "supabase": "^2.109.1",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
