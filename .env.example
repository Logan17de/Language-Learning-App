# Public browser/server credentials. The legacy anon key works with the current
# Supabase client; use the project's publishable key value here when available.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy projects may use this instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-local-or-project-service-role-key

# Server-side fallback for password-reset and confirmation redirects.
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel, set this to the production origin instead:
# NEXT_PUBLIC_APP_URL=https://language-learning-app-kappa-dusky.vercel.app

# Server-only OpenAI credentials used by Pro custom lesson generation and
# Reading speech-to-text. Never expose this through a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=your-openai-api-key

# GPT-5.6 Luna is the default model for every lesson-generation stage.
OPENAI_LESSON_MODEL=gpt-5.6-luna
# No automatic alternate model is used unless this is explicitly configured.
# OPENAI_LESSON_FALLBACK_MODEL=gpt-5.6-terra

# Reasoning effort can be tuned per stage without changing the pipeline.
OPENAI_STORY_REASONING_EFFORT=low
OPENAI_ENRICHMENT_REASONING_EFFORT=medium
OPENAI_VALIDATOR_REASONING_EFFORT=medium
# Optional model overrides by stage:
# OPENAI_STORY_MODEL=gpt-5.6-luna
# OPENAI_ENRICHMENT_MODEL=gpt-5.6-luna
# OPENAI_VALIDATOR_MODEL=gpt-5.6-luna

# Optional Responses API/proxy controls:
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# OPENAI_REQUEST_TIMEOUT_MS=120000

# Reading remains STT-only and uses the same OpenAI API key.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
