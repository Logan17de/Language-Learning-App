# Public browser/server credentials. The legacy anon key works with the current
# Supabase client; use the project's publishable key value here when available.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy projects may use this instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-local-or-project-service-role-key

# Server-side fallback for password-reset and confirmation redirects.
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel, set this to the production origin instead:
# NEXT_PUBLIC_APP_URL=https://language-learning-app-kappa-dusky.vercel.app

# Server-only Gemini credentials for Pro custom lesson generation.
# Never expose this value through a NEXT_PUBLIC_* variable.
GEMINI_API_KEY=your-gemini-api-key
# Primary and technical-failure fallback. Both support JSON Schema output.
GEMINI_LESSON_MODEL=gemini-3-flash-preview
GEMINI_LESSON_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional override for testing proxies; normally leave unset.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/interactions
