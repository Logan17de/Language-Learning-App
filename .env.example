# Public browser/server credentials. The legacy anon key works with the current
# Supabase client; use the project's publishable key value here when available.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy projects may use this instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-local-or-project-service-role-key

# Used for password-reset and confirmation redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only OpenAI credentials for Pro custom lesson generation.
OPENAI_API_KEY=your-openai-api-key
# Optional. AIko defaults to the current recommended structured-output model.
OPENAI_LESSON_MODEL=gpt-5.6
